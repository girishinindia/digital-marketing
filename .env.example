# ─── Supabase (Postgres direct + optional JS client) ──────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler (IPv4, port 5432) — recommended for Next.js server runtime
DATABASE_URL=

# DB schema all app objects live in
DB_SCHEMA=seo

# ─── JWT (custom auth) ────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Upstash Redis ────────────────────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_SESSION_TTL=1800
REDIS_CACHE_TTL=300
REDIS_OTP_TTL=600

# ─── Bunny Storage ────────────────────────────────────────────
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_URL=
BUNNY_CDN_URL=

# ─── reCAPTCHA (Google Enterprise) ────────────────────────────
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_MIN_SCORE=0.5
NEXT_PUBLIC_RECAPTCHA_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ─── AI providers (add the key for whichever you use) ─────────
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Task Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOW_PUBLIC_SIGNUP=false
